<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	이 파일은 예시입니다.
	- 실제 Bundle ID / Team / Associated Domains 설정에 맞게 Xcode에서 Capabilities로 관리하세요.
